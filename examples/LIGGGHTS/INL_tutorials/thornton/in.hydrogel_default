# --- 기본 설정 ---
atom_style	sphere
atom_modify	map array
boundary	f f f
newton		off
soft_particles yes


communicate	single vel yes
processors * * *
units		si

read_data input.data

neighbor	0.002 bin
neigh_modify	delay 0

# --- 재료 물성치 설정 ---
fix 		m1 all property/global youngsModulus peratomtype 23.3e3
#fix 		m1 all property/global youngsModulus peratomtype 5e6
fix 		m2 all property/global poissonsRatio peratomtype 0.25
fix 		m3 all property/global coefficientRestitution peratomtypepair 1 0.25
fix 		m4 all property/global coefficientFriction peratomtypepair 1 0.03
fix m5 all property/global surfaceEnergy peratomtypepair 1 0.2
fix m6 all property/global coefficientYieldRatio peratomtype 0.3

# --- 접촉 모델 설정 ---
pair_style gran model thornton_ning tangential history
pair_coeff	* *

# --- 중력 및 시간 설정 ---
variable dt equal 0.00001
timestep  ${dt}
fix gravi all gravity 9.81 vector 0.0 0.0 -1.0

# --- 시뮬레이션 박스 크기 변수 ---
variable sizeX equal 0.165190844117647
variable sizeY equal 0.165833589215686

# --- 고정 벽 정의 (모두 type 1로 수정) ---
fix wall_bottom all wall/gran model hertz tangential history primitive type 1 zplane 0.0
fix wall_left   all wall/gran model hertz tangential history primitive type 1 xplane 0.0
fix wall_rigth  all wall/gran model hertz tangential history primitive type 1 xplane ${sizeX}
fix wall_front  all wall/gran model hertz tangential history primitive type 1 yplane 0.0
fix wall_back   all wall/gran model hertz tangential history primitive type 1 yplane ${sizeY}

# --- 피스톤 속도 및 위치 설정 ---
variable startZ    equal 0.1676430125
variable endZ      equal 0.1175165625
variable ts_move   equal 20000
variable dz        equal ${endZ}-${startZ}
variable cvel      equal ${dz}/(${ts_move}*${dt})
variable rvel      equal -1*${cvel}

print "Velocity of piston: ${rvel}"

# --- STL 메시 피스톤 설정 (type 1로 수정) ---
fix piston_m all mesh/surface/stress file meshes/piston_hydrogel.stl type 1 move 0. 0. ${startZ}
fix piston all wall/gran model hertz tangential history mesh n_meshes 1 meshes piston_m

fix piston_force all ave/time 1 100 100 f_piston_m[1] f_piston_m[2] f_piston_m[3] file post/piston_force_thornton.txt

# --- 시간 적분 및 에너지 출력 설정 ---
fix integr all nve/sphere
compute 1 all erotate/sphere
thermo_style custom step atoms ke c_1 vol
thermo 1000

# --- 덤프 설정 (입자 및 메시) ---
fix piston_move all move/mesh mesh piston_m linear 0. 0. ${cvel}
run 1

dump dmp all custom/vtk 100 post/hydrogel_thornton*.vtk id type type x y z ix iy iz vx vy vz fx fy fz omegax omegay omegaz radius
dump dmp2 all mesh/vtk 100 post/hydrogel_thornton_mesh*.vtk id stress stresscomponents vel

# --- 피스톤 움직임 시뮬레이션 ---
run ${ts_move} upto
unfix piston_move

fix piston_move all move/mesh mesh piston_m linear 0. 0. ${rvel}
run ${ts_move}
unfix piston_move

fix piston_move all move/mesh mesh piston_m linear 0. 0. ${cvel}
run ${ts_move}
unfix piston_move

fix piston_move all move/mesh mesh piston_m linear 0. 0. ${rvel}
run ${ts_move}