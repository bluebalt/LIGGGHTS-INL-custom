#Contact model example

atom_style	granular
atom_modify	map array
boundary	f f f
newton		off

communicate	single vel yes

units		micro

region		reg block -75 75 -75 75 0. 300 units box
create_box	1 reg

neighbor		0.1 bin
neigh_modify	delay 0


#Material properties required for new pair styles

fix 		m1 all property/global youngsModulus peratomtype 1.42e8
fix 		m2 all property/global poissonsRatio peratomtype 0.25
fix 		m3 all property/global coefficientRestitution peratomtypepair 1 0.25
fix 		m4 all property/global coefficientFriction peratomtypepair 1 0.25
#fix 		m5 all property/global characteristicVelocity scalar 2.1


#New pair style
pair_style gran model hertz tangential history
pair_coeff	* *

timestep	0.001

#fix			gravi all gravity 9.81 vector 0.0 0.0 -1.0

fix zwalls1 all wall/gran model hertz tangential history primitive type 1 zplane 0.0
#fix zwalls2 all wall/gran model hertz tangential history primitive type 1 zplane 0.15
#fix cylwalls all wall/gran model hertz tangential history primitive type 1 zcylinder 0.05 0. 0.
fix zwalls3 all wall/gran model hertz tangential history primitive type 1 xplane -75
fix zwalls4 all wall/gran model hertz tangential history primitive type 1 xplane 75
fix zwalls5 all wall/gran model hertz tangential history primitive type 1 yplane -75
fix zwalls6 all wall/gran model hertz tangential history primitive type 1 yplane 75

#region of insertion
#region		bc cylinder z 0. 0. 0.045 0.00 0.15 units box
region		bc block -75 75 -75 75 0. 110 units box

#particle distributions
fix			pts1 all particletemplate/sphere 15485863 atom_type 1 density constant 4.75 radius constant 2.5
fix pts2 all particletemplate/sphere 15485863 atom_type 1 density constant 4.75 radius constant 7.5/2
fix pts3 all particletemplate/sphere 15485863 atom_type 1 density constant 4.75 radius constant 10.5/2
fix pts4 all particletemplate/sphere 15485863 atom_type 1 density constant 4.75 radius constant 15/2
fix pts5 all particletemplate/sphere 15485863 atom_type 1 density constant 4.75 radius constant 18/2
fix			pdd1 all particledistribution/discrete 15485867 5 pts1 1.0 pts2 0.2 pts3 0.2 pts4 0.25 pts5 0.15
#fix			pdd1 all particledistribution/discrete 15485867 1 pts1 1.0

fix			ins all insert/pack seed 32452843 distributiontemplate pdd1 vel constant 0. 0. 0. &
				insert_every once overlapcheck yes all_in yes particles_in_region 2237 region bc

#apply nve integration to all particles
fix			integr all nve/sphere

#output settings, include total thermal energy
compute		rke all erotate/sphere
thermo_style	custom step atoms ke c_rke vol
thermo			1000
thermo_modify	lost ignore norm no
dump			dmp all custom/vtk 800 post/newModels_*.vtk id type x y z ix iy iz vx vy vz fx fy fz omegax omegay omegaz radius


#insert particles
run				50000
unfix			ins

#run
run				100000 upto
